@page "{id:int}"
@using GencPusula.Web.Models
@model GencPusula.Web.Pages.FirsatDetayModel
@{
    ViewData["Title"] = Model.SeciliFirsat?.Baslik ?? "Fırsat Detayı";
}

@if (Model.SeciliFirsat == null)
{
    <div class="alert alert-warning mt-4">
        Aradığınız fırsat ilanı bulunamadı veya yayından kaldırılmış.
    </div>
    <a asp-page="/Firsatlar" class="btn btn-secondary">Fırsat Listesine Dön</a>
}
else
{
    var guncellik = GuncellikDurumu.Hesapla(Model.SeciliFirsat?.SonKontrolTarihi);
    var yoneticiMi = User.IsInRole(Roller.Yonetici);
    var kullaniciGirisYaptiMi = User.Identity?.IsAuthenticated == true && !yoneticiMi;
    var yoneticiEksikIlanVarMi = yoneticiMi && Model.UygunlukSonucu != null && Model.UygunlukSonucu.IlanUyarilari.Count > 0;
    var uygunlukGosterilsinMi = Model.UygunlukSonucu != null && (!yoneticiMi || yoneticiEksikIlanVarMi);
    var gosterilecekDurum = yoneticiEksikIlanVarMi ? "BilgiEksik" : Model.UygunlukSonucu?.Durum;
    var uygunlukGorunumu = UygunlukGorunumu.Olustur(gosterilecekDurum);

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <div>
                <span class="badge bg-dark me-2">@Model.SeciliFirsat!.FirsatTuru</span>
                <span class="badge @guncellik.Sinif me-2">@guncellik.Etiket</span>
                @if (uygunlukGosterilsinMi)
                {
                    <span class="badge @uygunlukGorunumu.RozetSinifi me-2">@uygunlukGorunumu.Etiket</span>
                }
                <span class="text-muted">@Model.SeciliFirsat.Sehir</span>
            </div>
            <div class="text-end">
                <div class="text-danger fw-bold small">
                    Son Başvuru Tarihi: @Model.SeciliFirsat.SonBasvuruTarihi.ToString("dd.MM.yyyy")
                </div>
                <div class="text-muted small">
                    Son Kontrol Tarihi: @(Model.SeciliFirsat.SonKontrolTarihi.HasValue ? Model.SeciliFirsat.SonKontrolTarihi.Value.ToString("dd.MM.yyyy") : "Belirtilmedi")
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <h3 class="card-title fw-bold mb-3">@Model.SeciliFirsat.Baslik</h3>
            <p class="card-text fs-6" style="line-height: 1.7;">
                @Model.SeciliFirsat.Aciklama
            </p>

            @if (uygunlukGosterilsinMi)
            {
                <div class="card border @uygunlukGorunumu.KartKenarlikSinifi mt-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Uygunluk Değerlendirmesi</h6>
                            <span class="badge @uygunlukGorunumu.RozetSinifi px-3 py-2">@uygunlukGorunumu.Etiket</span>
                        </div>

                        @if (!yoneticiMi)
                        {
                            <div class="alert @uygunlukGorunumu.KutuArkaPlanSinifi py-2 px-3 mb-3 small">
                                @Model.UygunlukSonucu!.Neden
                            </div>
                        }

                        @if (kullaniciGirisYaptiMi && Model.UygunlukSonucu!.ProfilUyarilari.Count > 0)
                        {
                            <div class="mb-2">
                                <div class="fw-semibold small text-dark mb-1">Eksik Profil Bilgileri:</div>
                                <ul class="small text-muted mb-0 ps-3">
                                    @foreach (var uyari in Model.UygunlukSonucu.ProfilUyarilari)
                                    {
                                        <li>@uyari</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (yoneticiEksikIlanVarMi)
                        {
                            <div class="mb-2">
                                <div class="fw-semibold small text-dark mb-1">Eksik İlan Bilgileri:</div>
                                <ul class="small text-muted mb-0 ps-3">
                                    @foreach (var uyari in Model.UygunlukSonucu!.IlanUyarilari)
                                    {
                                        <li>@uyari</li>
                                    }
                                </ul>
                                <div class="mt-3">
                                    <a asp-page="/Yonetim/FirsatDuzenle" asp-route-id="@Model.SeciliFirsat.Id" class="btn btn-dark btn-sm">İlan Bilgilerini Tamamla</a>
                                </div>
                            </div>
                        }

                        @if (kullaniciGirisYaptiMi && (!Model.ProfilKayitliMi || Model.UygunlukSonucu!.ProfilUyarilari.Count > 0))
                        {
                            <div class="mt-3">
                                <a asp-page="/Profil" class="btn btn-dark btn-sm">Profil Bilgilerini Tamamla</a>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="p-3 bg-light rounded border mt-4">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="mb-1">
                            <strong>Kaynak Bağlantısı:</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.SeciliFirsat.KaynakBaglantisi))
                            {
                                <a href="@Model.SeciliFirsat.KaynakBaglantisi" target="_blank" rel="noopener noreferrer" class="text-break">
                                    @Model.SeciliFirsat.KaynakBaglantisi
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Kaynak bağlantısı belirtilmemiş.</span>
                            }
                        </div>
                        <div>
                            <strong>Son Kontrol Tarihi:</strong>
                            <span>@(Model.SeciliFirsat.SonKontrolTarihi.HasValue ? Model.SeciliFirsat.SonKontrolTarihi.Value.ToString("dd.MM.yyyy") : "Belirtilmedi")</span>
                        </div>
                        <div class="p-3 bg-light rounded border mt-3">
                            <h6 class="fw-bold border-bottom pb-2 mb-3">Başvuru Şartları</h6>
                            <div class="row g-2 small">
                                <div class="col-md-6">
                                    <strong>Bölüm Şartı:</strong>
                                    <span>@(string.IsNullOrWhiteSpace(Model.SeciliFirsat.GerekliBolum) ? "İlanda belirtilmemiş" : Model.SeciliFirsat.GerekliBolum)</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>Sınıf Şartı:</strong>
                                    <span>@(string.IsNullOrWhiteSpace(Model.SeciliFirsat.GerekliSinif) ? "İlanda belirtilmemiş" : Model.SeciliFirsat.GerekliSinif)</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>Minimum Not Ortalaması (AGNO):</strong>
                                    <span>@(Model.SeciliFirsat.MinNotOrtalamasi.HasValue ? Model.SeciliFirsat.MinNotOrtalamasi.Value.ToString("0.00") : "İlanda belirtilmemiş")</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>Yabancı Dil Şartı:</strong>
                                    <span>@(string.IsNullOrWhiteSpace(Model.SeciliFirsat.GerekliDilSeviyesi) ? "İlanda belirtilmemiş" : Model.SeciliFirsat.GerekliDilSeviyesi)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        @if (!string.IsNullOrWhiteSpace(Model.SeciliFirsat.KaynakBaglantisi))
                        {
                            <a href="@Model.SeciliFirsat.KaynakBaglantisi" target="_blank" rel="noopener noreferrer" class="btn btn-dark btn-sm">
                                Resmi Kaynağı Aç
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light d-flex justify-content-between align-items-center py-3">
            <a asp-page="/Firsatlar" class="btn btn-outline-secondary">← Listeye Geri Dön</a>
            @if (yoneticiMi)
            {
                <a asp-page="/Yonetim/FirsatDuzenle" asp-route-id="@Model.SeciliFirsat.Id" class="btn btn-outline-primary btn-sm">
                    Bu İlanı Düzenle
                </a>
            }
        </div>
    </div>
}