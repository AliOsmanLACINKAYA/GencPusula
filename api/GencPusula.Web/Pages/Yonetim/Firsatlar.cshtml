@page
@model GencPusula.Web.Pages.Yonetim.FirsatlarModel
@{
    ViewData["Title"] = "Fırsat Yönetimi";
}

<div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
    <div>
        <h2 class="fw-bold mb-0">Fırsat Yönetim Paneli</h2>
        <p class="text-muted mb-0">Sistemdeki fırsat ilanlarını ekleyebilir, düzenleyebilir ve silebilirsiniz.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Firsatlar" class="btn btn-outline-secondary btn-sm">Kullanıcı Listesini Gör</a>
        <a asp-page="/Yonetim/FirsatEkle" class="btn btn-dark btn-sm">+ Yeni Fırsat Ekle</a>
    </div>
</div>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["BasariMesaji"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Firsatlar.Count == 0)
{
    <div class="alert alert-info text-center py-4">
        <h5 class="fw-bold mb-2">Kayıtlı Fırsat Bulunmuyor</h5>
        <p class="mb-3">Henüz sisteme eklenmiş bir fırsat ilanı yok.</p>
        <a asp-page="/Yonetim/FirsatEkle" class="btn btn-dark btn-sm">İlk Fırsatı Ekle</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tür</th>
                    <th>Başlık</th>
                    <th>Şehir</th>
                    <th>Son Başvuru</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var firsat in Model.Firsatlar)
                {
                    <tr>
                        <td>@firsat.Id</td>
                        <td><span class="badge bg-dark">@firsat.FirsatTuru</span></td>
                        <td class="fw-semibold">@firsat.Baslik</td>
                        <td>@firsat.Sehir</td>
                        <td>@firsat.SonBasvuruTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-page="/FirsatDetay" asp-route-id="@firsat.Id" class="btn btn-sm btn-outline-secondary">
                                    Detay
                                </a>
                                <a asp-page="/Yonetim/FirsatDuzenle" asp-route-id="@firsat.Id" class="btn btn-sm btn-outline-primary">
                                    Düzenle
                                </a>
                                <form method="post" asp-page-handler="Sil" asp-route-id="@firsat.Id" class="d-inline" onsubmit="return confirm('Bu fırsatı silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}