@page
@model GencPusula.Web.Pages.Yonetim.FirsatEkleModel
@{
    ViewData["Title"] = "Yeni Fırsat Ekle";
}

<div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
    <div>
        <h2 class="fw-bold mb-0">Yeni Fırsat Ekle</h2>
        <p class="text-muted mb-0">Kullanıcı listesinde yayınlanacak yeni bir fırsat ilanı oluşturun.</p>
    </div>
    <a asp-page="/Yonetim/Firsatlar" class="btn btn-outline-secondary btn-sm">Yönetim Paneline Dön</a>
</div>

<div class="card shadow-sm border-0 bg-light">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Firsat.Baslik" class="form-label fw-semibold">Fırsat Başlığı</label>
                    <input asp-for="Firsat.Baslik" class="form-control" placeholder="Örn: TÜBİTAK Lisans Burs Programı" required />
                    <span asp-validation-for="Firsat.Baslik" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Firsat.FirsatTuru" class="form-label fw-semibold">Kategori (Fırsat Türü)</label>
                    <select asp-for="Firsat.FirsatTuru" class="form-select" required>
                        <option value="">Seçiniz...</option>
                        @foreach (var kategori in Model.Kategoriler)
                        {
                            <option value="@kategori">@kategori</option>
                        }
                    </select>
                    <span asp-validation-for="Firsat.FirsatTuru" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Firsat.Sehir" class="form-label fw-semibold">Şehir</label>
                    <input asp-for="Firsat.Sehir" class="form-control" placeholder="Örn: Ankara, İstanbul, Online" required />
                    <span asp-validation-for="Firsat.Sehir" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Firsat.SonBasvuruTarihi" class="form-label fw-semibold">Son Başvuru Tarihi</label>
                    <input asp-for="Firsat.SonBasvuruTarihi" type="date" class="form-control" required />
                    <span asp-validation-for="Firsat.SonBasvuruTarihi" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Firsat.KaynakBaglantisi" class="form-label fw-semibold">Kaynak Bağlantısı (URL)</label>
                    <input asp-for="Firsat.KaynakBaglantisi" type="url" class="form-control" required />
                    <span asp-validation-for="Firsat.KaynakBaglantisi" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Firsat.Aciklama" class="form-label fw-semibold">Açıklama</label>
                    <textarea asp-for="Firsat.Aciklama" class="form-control" rows="4" placeholder="Fırsat hakkında detaylı bilgi..." required></textarea>
                    <span asp-validation-for="Firsat.Aciklama" class="text-danger small"></span>
                </div>

                <hr class="my-4" />
<h6 class="fw-bold text-uppercase text-secondary mb-3">Başvuru ve Uygunluk Şartları (İsteğe Bağlı)</h6>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Firsat.GerekliBolum" class="form-label fw-semibold"></label>
        <input asp-for="Firsat.GerekliBolum" class="form-control" placeholder="Örn: Bilgisayar Mühendisliği, Yazılım Mühendisliği" />
        <span asp-validation-for="Firsat.GerekliBolum" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Firsat.GerekliSinif" class="form-label fw-semibold"></label>
        <input asp-for="Firsat.GerekliSinif" class="form-control" placeholder="Örn: 3. Sınıf, 4. Sınıf" />
        <span asp-validation-for="Firsat.GerekliSinif" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Firsat.MinNotOrtalamasi" class="form-label fw-semibold"></label>
        <input asp-for="Firsat.MinNotOrtalamasi" type="number" step="0.01" min="0" max="4" class="form-control" placeholder="Örn: 2.50" />
        <span asp-validation-for="Firsat.MinNotOrtalamasi" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Firsat.GerekliDilSeviyesi" class="form-label fw-semibold"></label>
        <select asp-for="Firsat.GerekliDilSeviyesi" class="form-select">
            <option value="">Şart Belirtilmedi</option>
            <option value="A1">A1 - Başlangıç</option>
            <option value="A2">A2 - Temel</option>
            <option value="B1">B1 - Orta Altı</option>
            <option value="B2">B2 - Orta Üstü</option>
            <option value="C1">C1 - İleri</option>
            <option value="C2">C2 - Yetkin</option>
        </select>
        <span asp-validation-for="Firsat.GerekliDilSeviyesi" class="text-danger small"></span>
    </div>
</div>
                
                
                <div class="col-12 d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="/Yonetim/Firsatlar" class="btn btn-outline-secondary">İptal</a>
                    <button type="submit" class="btn btn-dark px-4">Kaydet ve Yayınla</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}