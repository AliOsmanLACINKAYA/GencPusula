@page
@using GencPusula.Web.Models
@model GencPusula.Web.Pages.FirsatlarModel
@{
    ViewData["Title"] = "Fırsatlar";
}

<div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
    <div>
        <h2 class="fw-bold mb-0">Fırsat Listesi</h2>
        <p class="text-muted mb-0">Son başvuru tarihine göre sıralanmıştır.</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole(GencPusula.Web.Models.Roller.Yonetici))
        {
            <a asp-page="/Yonetim/Firsatlar" class="btn btn-dark btn-sm">Fırsatları Yönet</a>
        }
        <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">Ana Sayfaya Dön</a>
    </div>
</div>

<div class="card shadow-sm border-0 bg-light mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="AramaMetni" class="form-label fw-semibold small mb-1">Anahtar Kelime Ara</label>
                <input type="text"
                       id="AramaMetni"
                       name="AramaMetni"
                       value="@Model.AramaMetni"
                       class="form-control"
                       placeholder="Başlık, açıklama veya şehir ara..." />
            </div>

            <div class="col-md-4">
                <label for="SeciliKategori" class="form-label fw-semibold small mb-1">Kategori (Fırsat Türü)</label>
                <select id="SeciliKategori" name="SeciliKategori" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var tur in Model.Kategoriler)
                    {
                        if (Model.SeciliKategori == tur)
                        {
                            <option value="@tur" selected>@tur</option>
                        }
                        else
                        {
                            <option value="@tur">@tur</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100">Filtrele</button>
                @if (!string.IsNullOrWhiteSpace(Model.AramaMetni) || !string.IsNullOrWhiteSpace(Model.SeciliKategori))
                {
                    <a asp-page="/Firsatlar" class="btn btn-outline-secondary">Temizle</a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.FirsatListesi.Count == 0)
{
    <div class="alert alert-warning text-center py-4 shadow-sm" role="alert">
        <h5 class="fw-bold mb-2">Sonuç Bulunamadı</h5>
        <p class="mb-3">Aradığınız kriterlere veya kategoriye uygun aktif bir fırsat ilanı bulunamadı.</p>
        <a asp-page="/Firsatlar" class="btn btn-sm btn-dark">Tüm Fırsatları Göster</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var firsat in Model.FirsatListesi)
        {
            var guncellik = GuncellikDurumu.Hesapla(firsat.SonKontrolTarihi);

            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-dark">@firsat.FirsatTuru</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @guncellik.Sinif">@guncellik.Etiket</span>
                                <small class="text-muted">@firsat.Sehir</small>
                            </div>
                        </div>

                        <h5 class="card-title fw-bold">@firsat.Baslik</h5>

                        <p class="card-text text-secondary flex-grow-1">
                            @(firsat.Aciklama.Length > 110
                                ? firsat.Aciklama.Substring(0, 110) + "..."
                                : firsat.Aciklama)
                        </p>

                        <div class="border-top pt-2 mt-2 small text-muted">
                            <div class="d-flex justify-content-between mb-1">
                                <span><strong>Son Başvuru:</strong> @firsat.SonBasvuruTarihi.ToString("dd.MM.yyyy")</span>
                                <span><strong>Son Kontrol:</strong> @(firsat.SonKontrolTarihi.HasValue ? firsat.SonKontrolTarihi.Value.ToString("dd.MM.yyyy") : "Belirtilmedi")</span>
                            </div>
                            <div class="text-truncate">
                                <strong>Kaynak:</strong>
                                @if (!string.IsNullOrWhiteSpace(firsat.KaynakBaglantisi))
                                {
                                    <a href="@firsat.KaynakBaglantisi" target="_blank" rel="noopener noreferrer" class="text-decoration-none">@firsat.KaynakBaglantisi</a>
                                }
                                else
                                {
                                    <span>Belirtilmedi</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                            @if (!string.IsNullOrWhiteSpace(firsat.KaynakBaglantisi))
                            {
                                <a href="@firsat.KaynakBaglantisi" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                                    Kaynağa Git
                                </a>
                            }
                            <a asp-page="/FirsatDetay" asp-route-id="@firsat.Id" class="btn btn-sm btn-outline-dark">
                                Detayları Gör
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}